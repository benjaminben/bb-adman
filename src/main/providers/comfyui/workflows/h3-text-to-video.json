{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load H3 model" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    },
    "_meta": { "title": "Load H3 text encoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" },
    "_meta": { "title": "Load video VAE" }
  },
  "4": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "Load audio VAE" }
  },
  "5": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "A slow, smooth dolly shot of a glass bottle of sparkling water on a wet stone table at sunrise. Soft golden light, small bubbles rising, gentle water drops sliding down the glass. Calm ambient sound of birds and a light breeze. Vertical framing, premium product advert look.",
      "width": 768,
      "height": 1344,
      "length": 56
    },
    "_meta": { "title": "H3 conditioning (APP: prompt, width, height, length)" }
  },
  "6": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 1 },
    "_meta": { "title": "Noise (APP: seed)" }
  },
  "7": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" }
  },
  "8": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["1", 0], "scheduler": "simple", "steps": 20, "denoise": 1 }
  },
  "9": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["1", 0], "conditioning": ["5", 0] }
  },
  "10": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["6", 0],
      "guider": ["9", 0],
      "sampler": ["7", 0],
      "sigmas": ["8", 0],
      "latent_image": ["5", 1]
    }
  },
  "11": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["10", 0], "vae": ["3", 0] },
    "_meta": { "title": "Decode frames" }
  },
  "12": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["10", 0], "vae": ["4", 0] },
    "_meta": { "title": "Decode sound" }
  },
  "13": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["11", 0],
      "audio": ["12", 0],
      "fps": 24,
      "bit_depth": 8,
      "color_space": "sRGB",
      "chroma_subsampling": "auto",
      "codec": "none"
    },
    "_meta": { "title": "Frames + sound into one video" }
  },
  "14": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["13", 0],
      "filename_prefix": "adman/test-h3-text",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    },
    "_meta": { "title": "Save MP4 to output folder (APP: output prefix)" }
  }
}
