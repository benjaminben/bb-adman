{
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "flux3-image-klein-base-int8-convrot.safetensors",
      "weight_dtype": "default"
    },
    "_meta": { "title": "Load Flux 3 klein (base)" }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "qwen3vl_4b_int8_convrot.safetensors",
      "type": "flux3",
      "device": "default"
    },
    "_meta": { "title": "Load Flux 3 text encoder" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "adman-reference-1.png" },
    "_meta": { "title": "Reference 1 = the source photo (APP: uploaded file name)" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["4", 0],
      "text": "Change the background of the first image to a stone table in soft morning light. Keep the bottle's shape, label and colours exactly the same."
    },
    "_meta": { "title": "Edit prompt (APP: text)" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["4", 0], "text": "" },
    "_meta": { "title": "Negative (reference default: empty)" }
  },
  "8": {
    "class_type": "ReferenceMultiLatent",
    "inputs": {
      "positive": ["6", 0],
      "negative": ["7", 0],
      "vae": ["5", 0],
      "images.image0": ["10", 0],
      "resolution": "resize",
      "resolution.megapixels": 1
    },
    "_meta": { "title": "References + size (size follows the references, at 1 MP)" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["8", 0],
      "negative": ["8", 1],
      "latent_image": ["8", 2],
      "seed": 1,
      "steps": 50,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": { "title": "Sampler (APP: seed)" }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["5", 0] }
  },
  "15": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["14", 0] },
    "_meta": { "title": "Result (temp folder only)" }
  }
}
