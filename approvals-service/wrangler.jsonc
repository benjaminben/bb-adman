// spec/approvals-service.md "Folder and tooling". No key, address or account value lives here:
// API_KEY is a secret, and the database ID is a placeholder the stakeholder replaces.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "adman-approvals",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "vars": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adman-approvals",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
