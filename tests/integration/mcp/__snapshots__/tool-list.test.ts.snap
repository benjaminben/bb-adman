  {
    "description": "Delete one layer of an open project. The background layer cannot be deleted. Gives the layer ID. The user can undo the change.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "layer_id": {
          "minLength": 1,
