      ],
      "type": "object",
    },
    "name": "get_check_results",
  },
  {
    "description": "Change one variant of an open project to "image" or "video". A change to video makes the first clip from the background's picture, once; a change back to image keeps the clips. It is refused when the direction already has a variant at the same size and language in that format. Gives the variant ID. The user can undo the change.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "format": {
          "enum": [
            "image",
            "video",
