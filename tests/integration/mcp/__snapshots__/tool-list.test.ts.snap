  },
  {
    "description": "Set the stacking order of one variant of an open project. layer_ids lists every layer of the variant except the background, each once, lowest first. Gives the variant ID. The user can undo the change.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
