// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`the MCP tool list [SPEC 10.3, 4.5] > matches the pinned names, descriptions and input schemas 1`] = `
[
  {
    "description": "List the projects open in the app, with the ID and name of each. Use an ID as project_id in the other tools.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {},
      "type": "object",
    },
    "name": "list_projects",
  },
  {
    "description": "Read one project that is open in the app: meta (project ID, name, schema version, the app version that made it, created time), its subjects, a summary of each campaign in campaigns, and missingAssetCount, the number of assets whose file cannot be found. Works only on open projects.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
      ],
      "type": "object",
    },
    "name": "get_project",
  },
  {
    "description": "List the assets of an open project, optionally by library, kind or subject. Gives id, display name, kind, library, subject ID, width, height, duration and font family.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "kind": {
          "enum": [
            "image",
            "video",
            "font",
            "text",
          ],
          "type": "string",
        },
        "library": {
          "enum": [
            "reference",
            "asset",
          ],
          "type": "string",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "subject_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
      ],
      "type": "object",
    },
    "name": "list_assets",
  },
  {
    "description": "Read one campaign of an open project: its fields, rule set, directions and a summary of each variant with its badges.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "campaign_id": {
          "minLength": 1,
          "type": "string",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "campaign_id",
      ],
      "type": "object",
    },
    "name": "get_campaign",
  },
  {
    "description": "Create a campaign in an open project from a confirmed brief, with one subject_map entry per brief subject. sizes and languages may be left out: the brief’s own are used, else the sizes 1x1, 9x16 and 16x9 and the main language of the brief’s region. Gives the new campaign ID, its first direction ID and its master variant ID.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "brief": {
          "properties": {
            "audience": {
              "minLength": 1,
              "type": "string",
            },
            "callToAction": {
              "type": "string",
            },
            "campaignName": {
              "minLength": 1,
              "type": "string",
            },
            "copy": {
              "additionalProperties": {
                "properties": {
                  "callToAction": {
                    "type": "string",
                  },
                  "headline": {
                    "type": "string",
                  },
                },
                "type": "object",
              },
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "languages": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "message": {
              "minLength": 1,
              "type": "string",
            },
            "offer": {
              "type": "string",
            },
            "prohibitedWords": {
              "anyOf": [
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                {
                  "additionalProperties": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "propertyNames": {
                    "type": "string",
                  },
                  "type": "object",
                },
              ],
            },
            "region": {
              "minLength": 1,
              "type": "string",
            },
            "requiredWords": {
              "anyOf": [
                {
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                {
                  "additionalProperties": {
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "propertyNames": {
                    "type": "string",
                  },
                  "type": "object",
                },
              ],
            },
            "sizes": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "subjects": {
              "items": {
                "properties": {
                  "description": {
                    "type": "string",
                  },
                  "id": {
                    "type": "string",
                  },
                  "name": {
                    "minLength": 1,
                    "type": "string",
                  },
                },
                "required": [
                  "name",
                ],
                "type": "object",
              },
              "minItems": 1,
              "type": "array",
            },
            "tone": {
              "type": "string",
            },
          },
          "required": [
            "campaignName",
            "region",
            "audience",
            "message",
            "subjects",
          ],
          "type": "object",
        },
        "copy_rule_set_from": {
          "minLength": 1,
          "type": "string",
        },
        "languages": {
          "items": {
            "maxLength": 35,
            "minLength": 1,
            "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
            "type": "string",
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "rule_set": {
          "properties": {
            "palette": {
              "items": {
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "type": "string",
              },
              "type": "array",
            },
            "prohibitedWords": {
              "additionalProperties": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "requiredAssetIds": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "requiredWords": {
              "additionalProperties": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
          },
          "required": [
            "requiredAssetIds",
            "palette",
            "requiredWords",
            "prohibitedWords",
          ],
          "type": "object",
        },
        "sizes": {
          "items": {
            "properties": {
              "height": {
                "maximum": 8192,
                "minimum": 50,
                "type": "integer",
              },
              "label": {
                "pattern": "^[1-9]\\d*x[1-9]\\d*$",
                "type": "string",
              },
              "width": {
                "maximum": 8192,
                "minimum": 50,
                "type": "integer",
              },
            },
            "required": [
              "label",
              "width",
              "height",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "minItems": 1,
          "type": "array",
        },
        "subject_map": {
          "items": {
            "properties": {
              "create": {
                "type": "boolean",
              },
              "subjectId": {
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "subjectId",
              "create",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "template_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "brief",
        "subject_map",
        "template_id",
      ],
      "type": "object",
    },
    "name": "create_campaign",
  },
  {
    "description": "Read the slots of a campaign's master variant: for each, its slot ID, type, whether it is filled or empty, and the IDs of the assets that could fill it.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "campaign_id": {
          "minLength": 1,
          "type": "string",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "campaign_id",
      ],
      "type": "object",
    },
    "name": "get_slots",
  },
  {
    "description": "Read one run (job) of an open project: its status, progress, the asset IDs it made, layout for a propose_layout run and copyOptions for a copy_options run once it has succeeded, and, when it failed, a plain message. Poll no more than once every 5 seconds.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "job_id": {
          "minLength": 1,
          "type": "string",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "job_id",
      ],
      "type": "object",
    },
    "name": "get_job",
  },
  {
    "description": "List the runs (jobs) of an open project, newest first, optionally by campaign, variant or state (active, unseen or failed), up to limit (default 200).",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "campaign_id": {
          "minLength": 1,
          "type": "string",
        },
        "limit": {
          "default": 200,
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "state": {
          "enum": [
            "active",
            "unseen",
            "failed",
          ],
          "type": "string",
        },
        "variant_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
      ],
      "type": "object",
    },
    "name": "list_jobs",
  },
  {
    "description": "Start a run that makes pictures for one variant of an open project. Name a slot (from get_slots) or a layer_id, not both. count is 1 to 8. reference_asset_ids are asset IDs from list_assets, or an empty list. provider is "comfyui" (the user's own ComfyUI server, no charge; the model is the one its workflow uses: MOSS-Image or FLUX 3 klein for pictures, MiniMax H3 for videos) or "gemini" (pictures with Nano Banana 2.1, model ID "gemini-nano-banana-2.1", not videos; paid, charged to the user's Google account with no click). Runs are refused unless the user allowed agents for that provider in Adman's Settings. Gives the job ID at once; follow the run with get_job. A run you start makes options for the user to choose from. Leave the choice to the user unless they asked you to choose.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "count": {
          "maximum": 8,
          "minimum": 1,
          "type": "integer",
        },
        "layer_id": {
          "minLength": 1,
          "type": "string",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "prompt": {
          "minLength": 1,
          "type": "string",
        },
        "provider": {
          "minLength": 1,
          "type": "string",
        },
        "reference_asset_ids": {
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 8,
          "type": "array",
        },
        "slot": {
          "minLength": 1,
          "type": "string",
        },
        "variant_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "variant_id",
        "prompt",
        "reference_asset_ids",
        "count",
        "provider",
      ],
      "type": "object",
    },
    "name": "generate_images",
  },
  {
    "description": "Start a run that makes a video clip for one variant of an open project. duration_ms is the clip length in milliseconds. Three starts: from the prompt alone (start "none", use_references false, reference_asset_ids empty); from a first-frame picture (start "first_frame", use_references false, one ID in reference_asset_ids); with reference pictures (start "none", use_references true, their IDs in reference_asset_ids). A picture is named by an asset ID from list_assets. A fourth start, "background" (use_references false, reference_asset_ids empty), uses the variant's background picture as the first frame. provider is "comfyui" (the user's own ComfyUI server, no charge; the model is the one its workflow uses: MOSS-Image or FLUX 3 klein for pictures, MiniMax H3 for videos) or "gemini" (pictures with Nano Banana 2.1, model ID "gemini-nano-banana-2.1", not videos; paid, charged to the user's Google account with no click). Runs are refused unless the user allowed agents for that provider in Adman's Settings. For a video, provider can also be "fal-seedance" (fal.ai Seedance with Seedance 2.0, model ID "bytedance/seedance-2.0/image-to-video"; paid, charged to the user's fal.ai account with no click; duration_ms from 4000 to 15000, in whole seconds; at most 8 reference pictures). Gives the job ID at once; follow the run with get_job. A run you start makes options for the user to choose from. Leave the choice to the user unless they asked you to choose.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "duration_ms": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "prompt": {
          "minLength": 1,
          "type": "string",
        },
        "provider": {
          "minLength": 1,
          "type": "string",
        },
        "reference_asset_ids": {
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 8,
          "type": "array",
        },
        "start": {
          "enum": [
            "none",
            "first_frame",
            "background",
          ],
          "type": "string",
        },
        "use_references": {
          "type": "boolean",
        },
        "variant_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "variant_id",
        "prompt",
        "duration_ms",
        "provider",
        "start",
        "use_references",
        "reference_asset_ids",
      ],
      "type": "object",
    },
    "name": "generate_video",
  },
  {
    "description": "Cancel a run (job) of an open project that an agent started. Runs the user started cannot be cancelled. Some providers cannot stop a run once it is sent; the refusal says so. Gives the job ID; follow the run with get_job.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "job_id": {
          "minLength": 1,
          "type": "string",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "job_id",
      ],
      "type": "object",
    },
    "name": "cancel_job",
  },
  {
    "description": "List the subjects of an open project: for each, its ID, name, description and the IDs of the assets that show it.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
      ],
      "type": "object",
    },
    "name": "list_subjects",
  },
  {
    "description": "Read one variant of an open project: its fields and badges, its campaign ID, every layer with all its values (z ascending), its video clips, and the assets its layers use, with display name, kind, size and whether the file is missing.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "variant_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "variant_id",
      ],
      "type": "object",
    },
    "name": "get_variant",
  },
  {
    "description": "Draw one variant of an open project as it looks now, with every layer, and get it back as one PNG picture. max_dimension sets the longer side (64 to 2048, default 1024, never larger than the variant); time_ms is the moment of a video variant to draw (default 0). Changes nothing in the project.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "max_dimension": {
          "default": 1024,
          "maximum": 2048,
          "minimum": 64,
          "type": "integer",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "time_ms": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer",
        },
        "variant_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "variant_id",
      ],
      "type": "object",
    },
    "name": "render_variant",
  },
  {
    "description": "Add a picture or text layer on top of one variant of an open project. type is "image" or "text"; values may set name, copy, style, geometry, source, visible and locked. Gives the new layer ID. The user can undo the change. A picture is set as source: { assetId } with an asset ID from list_assets (asset library, kind image); source null clears it. A font is set as style.fontAssetId with a font asset ID, or null for the default font. A run you start makes options for the user to choose from. Leave the choice to the user unless they asked you to choose.",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "type": {
          "enum": [
            "image",
            "text",
          ],
          "type": "string",
        },
        "values": {
          "additionalProperties": false,
          "properties": {
            "copy": {
              "maxLength": 5000,
              "type": "string",
            },
            "geometry": {
              "additionalProperties": false,
              "properties": {
                "crop": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "height": {
                          "minimum": 1,
                          "type": "number",
                        },
                        "width": {
                          "minimum": 1,
                          "type": "number",
                        },
                        "x": {
                          "type": "number",
                        },
                        "y": {
                          "type": "number",
                        },
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height",
                      ],
                      "type": "object",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "height": {
                  "minimum": 1,
                  "type": "number",
                },
                "rotation": {
                  "type": "number",
                },
                "width": {
                  "minimum": 1,
                  "type": "number",
                },
                "x": {
                  "type": "number",
                },
                "y": {
                  "type": "number",
                },
              },
              "type": "object",
            },
            "locked": {
              "type": "boolean",
            },
            "name": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string",
            },
            "source": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "assetId": {
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "assetId",
                  ],
                  "type": "object",
                },
                {
                  "type": "null",
                },
              ],
            },
            "style": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "align": {
                      "enum": [
                        "left",
                        "center",
                        "right",
                      ],
                      "type": "string",
                    },
                    "allCaps": {
                      "type": "boolean",
                    },
                    "boxColor": {
                      "anyOf": [
                        {
                          "pattern": "^#[0-9A-Fa-f]{6}$",
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "boxOutlineColor": {
                      "anyOf": [
                        {
                          "pattern": "^#[0-9A-Fa-f]{6}$",
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "boxOutlineWidth": {
                      "maximum": 100,
                      "minimum": 0,
                      "type": "number",
                    },
                    "boxPadding": {
                      "maximum": 2000,
                      "minimum": 0,
                      "type": "number",
                    },
                    "boxRadius": {
                      "maximum": 2000,
                      "minimum": 0,
                      "type": "number",
                    },
                    "color": {
                      "pattern": "^#[0-9A-Fa-f]{6}$",
                      "type": "string",
                    },
                    "fontAssetId": {
                      "type": [
                        "string",
                        "null",
                      ],
                    },
                    "fontSize": {
                      "exclusiveMinimum": 0,
                      "type": "number",
                    },
                    "fontWeight": {
                      "type": "number",
                    },
                    "letterSpacing": {
                      "maximum": 1,
                      "minimum": -0.2,
                      "type": "number",
                    },
                    "lineHeight": {
                      "type": "number",
                    },
                    "verticalAlign": {
                      "enum": [
                        "top",
                        "middle",
                        "bottom",
                      ],
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "fillColor": {
                      "anyOf": [
                        {
                          "pattern": "^#[0-9A-Fa-f]{6}$",
                          "type": "string",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                    "opacity": {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number",
                    },
                    "shade": {
                      "anyOf": [
                        {
                          "additionalProperties": false,
                          "properties": {
                            "color": {
                              "pattern": "^#[0-9A-Fa-f]{6}$",
                              "type": "string",
                            },
                            "from": {
                              "enum": [
                                "bottom",
                                "top",
                                "left",
                                "right",
                                "all",
                              ],
                              "type": "string",
                            },
                            "reach": {
                              "maximum": 1,
                              "minimum": 0.05,
                              "type": "number",
                            },
                            "strength": {
                              "maximum": 1,
                              "minimum": 0,
                              "type": "number",
                            },
                          },
                          "required": [
                            "color",
                            "from",
                            "strength",
                            "reach",
                          ],
                          "type": "object",
                        },
                        {
                          "type": "null",
                        },
                      ],
                    },
                  },
                  "type": "object",
                },
              ],
            },
            "visible": {
              "type": "boolean",
            },
          },
          "type": "object",
        },
        "variant_id": {
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "project_id",
        "variant_id",
        "type",
      ],
      "type": "object",
    },
    "name": "create_layer",
  },
  {
    "description": "Change one layer of an open project. patch holds only the fields to change. Fields: name, visible, locked, copy (text layers), style (merged into the stored style), geometry (x, y, width, height, rotation, crop; merged), source, timing, animation. Gives the layer ID. The user can undo the change. A picture is set as source: { assetId } with an asset ID from list_assets (asset library, kind image); source null clears it. A font is set as style.fontAssetId with a font asset ID, or null for the default font. A run you start makes options for the user to choose from. Leave the choice to the user unless they asked you to choose.",
