          "minLength": 1,
          "type": "string",
        },
        "languages": {
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "minItems": 1,
          "type": "array",
        },
        "project_id": {
          "minLength": 1,
          "type": "string",
        },
        "rule_set": {
          "properties": {
            "palette": {
              "items": {
                "pattern": "^#[0-9A-Fa-f]{6}$",
                "type": "string",
              },
              "type": "array",
            },
            "prohibitedWords": {
              "additionalProperties": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
            "requiredAssetIds": {
              "items": {
                "type": "string",
              },
              "type": "array",
            },
            "requiredWords": {
              "additionalProperties": {
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "propertyNames": {
                "type": "string",
              },
              "type": "object",
            },
          },
          "required": [
            "requiredAssetIds",
            "palette",
            "requiredWords",
            "prohibitedWords",
          ],
          "type": "object",
        },
        "sizes": {
          "items": {
            "properties": {
              "height": {
                "maximum": 8192,
                "minimum": 50,
                "type": "integer",
              },
              "label": {
                "pattern": "^[1-9]\\d*x[1-9]\\d*$",
                "type": "string",
              },
              "width": {
                "maximum": 8192,
                "minimum": 50,
                "type": "integer",
              },
            },
            "required": [
