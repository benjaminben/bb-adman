      ],
      "type": "object",
    },
    "name": "delete_campaign",
  },
  {
    "description": "Add one variant to a direction of an open project, at a size and a language from the campaign's lists, made from the direction's master with its background scaled to fit. Text layers in a language other than the master's start as "missing" until text is set. No translation is started. The user can undo it. Gives the new variant ID.",
    "inputSchema": {
