{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "moss_image_sft_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load MOSS-Image (SFT)" }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["1", 0], "lora_name": "moss_image_edit_lora_rank_64_bf16.safetensors", "strength_model": 1 },
    "_meta": { "title": "MOSS edit LoRA" }
  },
  "3": {
    "class_type": "SkipLayerGuidanceDiTSimple",
    "inputs": { "model": ["2", 0], "double_layers": "", "single_layers": "22", "start_percent": 0, "end_percent": 1 }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3.5_9b_w4a8_gptq.safetensors", "type": "moss_image", "device": "default" },
    "_meta": { "title": "Load MOSS text encoder" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae_small.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "adman-background.png" },
    "_meta": { "title": "Background to extend (APP: uploaded file name)" }
  },
  "11": {
    "class_type": "ImageScale",
    "inputs": { "image": ["10", 0], "upscale_method": "lanczos", "width": 1056, "height": 1056, "crop": "disabled" },
    "_meta": { "title": "Scaled picture size (APP: width, height of the placed picture)" }
  },
  "12": {
    "class_type": "ImagePadForOutpaint",
    "inputs": { "image": ["11", 0], "left": 0, "top": 408, "right": 0, "bottom": 408, "feathering": 24 },
    "_meta": { "title": "Grey border to fill (APP: pad left, top, right, bottom). Picture + pads = 1056x1872" }
  },
  "13": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": { "image": ["12", 0], "upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 16 },
    "_meta": { "title": "Padded picture as the edit reference" }
  },
  "6": {
    "class_type": "TextEncodeMOSSImageEdit",
    "inputs": {
      "clip": ["4", 0],
      "vae": ["5", 0],
      "images.image_0": ["13", 0],
      "prompt": "Fill the flat grey areas at the top and bottom by extending the existing scene naturally. Keep everything in the middle unchanged. Match the lighting, colours, perspective and texture. No new objects, no text, no borders.",
      "edit_format": "Moss-Image-Edit",
      "image_strength": 1
    },
    "_meta": { "title": "Extend instruction (APP: prompt)" }
  },
  "7": {
    "class_type": "TextEncodeMOSSImageEdit",
    "inputs": {
      "clip": ["4", 0],
      "vae": ["5", 0],
      "images.image_0": ["13", 0],
      "prompt": "nsfw, worst quality, bad anatomy, watermark, jpeg artifact, grey border, frame, seam",
      "edit_format": "Moss-Image-Edit",
      "image_strength": 1
    },
    "_meta": { "title": "Negative" }
  },
  "16": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["12", 0], "vae": ["5", 0] },
    "_meta": { "title": "Padded picture into latent" }
  },
  "17": {
    "class_type": "SetLatentNoiseMask",
    "inputs": { "samples": ["16", 0], "mask": ["12", 1] },
    "_meta": { "title": "Only repaint the border" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["17", 0],
      "seed": 1,
      "steps": 30,
      "cfg": 4,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    },
    "_meta": { "title": "Sampler (APP: seed)" }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["5", 0] }
  },
  "15": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["14", 0] },
    "_meta": { "title": "Result (temp folder only)" }
  }
}
