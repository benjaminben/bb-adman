{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load Krea 2 Turbo" }
  },
  "18": {
    "class_type": "DifferentialDiffusion",
    "inputs": { "model": ["1", 0], "strength": 1 },
    "_meta": { "title": "Soft blend at the mask edge" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default" },
    "_meta": { "title": "Load Krea 2 text encoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "adman-background.png" },
    "_meta": { "title": "Background to extend (APP: uploaded file name)" }
  },
  "11": {
    "class_type": "ImageScale",
    "inputs": { "image": ["10", 0], "upscale_method": "lanczos", "width": 1056, "height": 1056, "crop": "disabled" },
    "_meta": { "title": "Scaled picture size (APP: width, height of the placed picture)" }
  },
  "12": {
    "class_type": "ImagePadForOutpaint",
    "inputs": { "image": ["11", 0], "left": 0, "top": 408, "right": 0, "bottom": 408, "feathering": 24 },
    "_meta": { "title": "Grey border to fill (APP: pad left, top, right, bottom). Picture + pads = 1056x1872" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "A seamless continuation of the same scene: a wet stone table in soft golden morning light, a clean pale background, matching colours, perspective and texture. No text, no borders."
    },
    "_meta": { "title": "Describe the whole extended scene (APP: prompt)" }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["4", 0] },
    "_meta": { "title": "Empty negative (template)" }
  },
  "16": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["12", 0], "vae": ["3", 0] },
    "_meta": { "title": "Padded picture into latent" }
  },
  "17": {
    "class_type": "SetLatentNoiseMask",
    "inputs": { "samples": ["16", 0], "mask": ["12", 1] },
    "_meta": { "title": "Only repaint the border" }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["18", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["17", 0],
      "seed": 1,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": { "title": "Sampler, 8 steps (APP: seed)" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["3", 0] }
  },
  "9": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["8", 0] },
    "_meta": { "title": "Result (temp folder only)" }
  }
}
