{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "moss_image_sft_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load MOSS-Image (SFT)" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3.5_9b_w4a8_gptq.safetensors", "type": "moss_image", "device": "default" },
    "_meta": { "title": "Load MOSS text encoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae_small.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "Studio product photograph of a glass bottle of sparkling water on a wet stone table, soft golden morning light, small water drops on the glass, clean pale background with space at the top for a headline, premium advert look, vertical framing."
    },
    "_meta": { "title": "Positive prompt (APP: prompt)" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "nsfw, worst quality, bad anatomy, watermark, jpeg artifact" },
    "_meta": { "title": "Negative prompt (template default)" }
  },
  "6": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": 1056, "height": 1872, "batch_size": 1 },
    "_meta": { "title": "Size (APP: width, height)" }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "seed": 1,
      "steps": 25,
      "cfg": 2.5,
      "sampler_name": "er_sde",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": { "title": "Sampler (APP: seed)" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["3", 0] }
  },
  "9": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["8", 0] },
    "_meta": { "title": "Result (temp folder only)" }
  }
}
