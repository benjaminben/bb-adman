{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "moss_image_sft_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load MOSS-Image (SFT)" }
  },
  "2": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["1", 0], "lora_name": "moss_image_edit_lora_rank_64_bf16.safetensors", "strength_model": 1 },
    "_meta": { "title": "MOSS edit LoRA" }
  },
  "3": {
    "class_type": "SkipLayerGuidanceDiTSimple",
    "inputs": { "model": ["2", 0], "double_layers": "", "single_layers": "22", "start_percent": 0, "end_percent": 1 }
  },
  "4": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3.5_9b_w4a8_gptq.safetensors", "type": "moss_image", "device": "default" },
    "_meta": { "title": "Load MOSS text encoder" }
  },
  "5": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "flux2-vae_small.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "adman-reference-1.png" },
    "_meta": { "title": "Reference 1 = the source photo (APP: uploaded file name)" }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": { "image": "adman-reference-2.png" },
    "_meta": { "title": "Reference 2 (APP: uploaded file name)" }
  },
  "12": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": { "image": ["10", 0], "upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 16 }
  },
  "13": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": { "image": ["11", 0], "upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 16 }
  },
  "6": {
    "class_type": "TextEncodeMOSSImageEdit",
    "inputs": {
      "clip": ["4", 0],
      "vae": ["5", 0],
      "images.image_0": ["12", 0],
      "images.image_1": ["13", 0],
      "prompt": "Place the bottle from the first picture on the stone table from the second picture. Keep the bottle's shape, label and colours exactly the same. Soft morning light, vertical advert framing with space at the top for a headline.",
      "edit_format": "Moss-Image-Edit",
      "image_strength": 1
    },
    "_meta": { "title": "Edit prompt + references (APP: prompt)" }
  },
  "7": {
    "class_type": "TextEncodeMOSSImageEdit",
    "inputs": {
      "clip": ["4", 0],
      "vae": ["5", 0],
      "images.image_0": ["12", 0],
      "prompt": "nsfw, worst quality, bad anatomy, watermark, jpeg artifact",
      "edit_format": "Moss-Image-Edit",
      "image_strength": 1
    },
    "_meta": { "title": "Negative (template default)" }
  },
  "8": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": 1056, "height": 1872, "batch_size": 1 },
    "_meta": { "title": "Size (APP: width, height)" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["3", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["8", 0],
      "seed": 1,
      "steps": 30,
      "cfg": 4,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1
    },
    "_meta": { "title": "Sampler (APP: seed)" }
  },
  "14": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["9", 0], "vae": ["5", 0] }
  },
  "15": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["14", 0] },
    "_meta": { "title": "Result (temp folder only)" }
  }
}
