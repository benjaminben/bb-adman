{
  "1": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "krea2_turbo_fp8_scaled.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load Krea 2 Turbo" }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_4b_fp8_scaled.safetensors", "type": "krea2", "device": "default" },
    "_meta": { "title": "Load Krea 2 text encoder" }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "qwen_image_vae.safetensors" },
    "_meta": { "title": "Load VAE" }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["2", 0],
      "text": "Studio product photograph of a glass bottle of sparkling water on a wet stone table, soft golden morning light, small water drops on the glass, clean pale background with space at the top for a headline, premium advert look, vertical framing."
    },
    "_meta": { "title": "Prompt (APP: prompt)" }
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["4", 0] },
    "_meta": { "title": "Empty negative (template)" }
  },
  "6": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 1056, "height": 1872, "batch_size": 1 },
    "_meta": { "title": "Size (APP: width, height)" }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0],
      "seed": 1,
      "steps": 8,
      "cfg": 1,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1
    },
    "_meta": { "title": "Sampler, 8 steps (APP: seed)" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["7", 0], "vae": ["3", 0] }
  },
  "9": {
    "class_type": "PreviewImage",
    "inputs": { "images": ["8", 0] },
    "_meta": { "title": "Result (temp folder only)" }
  }
}
