{
  "name": "adman",
  "productName": "Adman",
  "version": "0.1.0",
  "description": "Desktop app for building localized campaign creatives",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "npm run build && playwright test",
    "db:generate": "drizzle-kit generate",
    "package": "npm run build && electron-builder",
    "package:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1174.0",
    "@aws-sdk/lib-storage": "3.1174.0",
    "@google/genai": "3.6.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "dropbox": "10.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "3.0.2",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "4.14.1",
    "drizzle-kit": "0.31.11",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "better-sqlite3@13.2.0": false,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": false,
    "protobufjs@7.6.6": false
  }
}
